  "derived_columns": {
    "note": "These columns are created during preprocessing and do not exist in raw DHS files.",
    "elevated_glucose_proxy": {
      "source_women": "sb74",
      "source_men": "smb74",
      "rule": "1 if glucose_mg_dl >= 200 else 0",
      "label": "elevated glucose (proxy)",
      "type": "binary"
    },
    "any_tobacco": {
      "source_women": "v463a through v463x, s711",
      "source_men": "mv463a through mv463x",
      "rule": "1 if any tobacco variable is positive, else 0",
      "type": "binary"
    },
    "age_band": {
      "source": "v012 / mv012",
      "type": "categorical",
      "bands_women": ["15-24", "25-34", "35-49"],
      "bands_men":   ["15-24", "25-34", "35-54"]
    },
    "bmi_band": {
      "source": "v445",
      "type": "categorical",
      "bands": ["underweight", "normal", "overweight", "obese"],
      "note": "Divide raw v445 by 100 before banding."
    },
