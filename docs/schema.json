      "sb74": {
        "label": "glucose level",
        "type": "continuous",
        "role": "OUTCOME",
        "derived_as": "elevated_glucose_proxy",
        "threshold_mg_dl": 200,
        "CRITICAL_RULES": [
          "This is the ONLY outcome variable.",
          "NEVER use as a conditioning/what-if input.",
          "NEVER impute. If missing, exclude row from outcome_stat only.",
