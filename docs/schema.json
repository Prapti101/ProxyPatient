        "role": "feature",
        "missing_codes": [99]
      },

      "s708": {
        "label": "do you currently smoke bidis",
        "type": "categorical",
        "role": "feature",
        "missing_codes": [9]
      },

      "s711": {
        "label": "currently smokes or uses tobacco besides cigarettes",
        "type": "categorical",
        "role": "feature",
        "missing_codes": [9]
      },

      "s720": {
        "label": "do you drink alcohol",
        "type": "categorical",
        "role": "conditioning",
        "derived_as": "alcohol",
        "values": {"0": "no", "1": "yes"},
        "missing_codes": [9]
      },

      "s721": {
        "label": "how often do you drink alcohol",
        "type": "categorical",
