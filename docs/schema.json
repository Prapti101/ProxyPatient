      },

      "sb57": {
        "label": "currently taking a prescribed medicine to lower blood glucose",
        "type": "categorical",
        "role": "feature",
        "missing_codes": [9]
      },

      "sb73": {
        "label": "time of blood glucose reading (hhmm - 24 hour clock)",
        "type": "continuous",
        "role": "reference_only",
        "note": "Used to determine fasting vs random. Verify with codebook.",
        "missing_codes": [9994, 9995, 9996, 9997, 9998, 9999]
      },

      "sb74": {
        "label": "glucose level",
        "type": "continuous",
        "role": "OUTCOME",
        "derived_as": "elevated_glucose_proxy",
        "threshold_mg_dl": 200,
        "CRITICAL_RULES": [
          "This is the ONLY outcome variable.",
          "NEVER use as a conditioning/what-if input.",
          "NEVER impute. If missing, exclude row from outcome_stat only.",
          "Always label result as 'elevated glucose (proxy)', never 'diabetes'."
